{
    "name": "laravel-notification-channels/sendly",
    "description": "Sendly SMS notification channel for Laravel",
    "homepage": "https://github.com/laravel-notification-channels/sendly",
    "license": "MIT",
    "authors": [
        {
            "name": "Laravel Notification Channels",
            "homepage": "https://github.com/laravel-notification-channels",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/notifications": "~10.0 || ~11.0",
        "illuminate/support": "~10.0 || ~11.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "NotificationChannels\\Sendly\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NotificationChannels\\Sendly\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-clover=coverage.clover"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "NotificationChannels\\Sendly\\SendlyServiceProvider"
            ]
        }
    }
}
